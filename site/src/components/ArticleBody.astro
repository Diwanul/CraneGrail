---
// 文章本体：主页阅读模式和 /<slug>/ 独立页面共用同一份 HTML。
// 主页打开文章时，会 fetch /<slug>/ 并从里面取出 .reader-doc 这一段直接放进主页（见 scripts/reader.ts），
// 所以这里不能依赖任何只在独立页面才有的东西。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AboutHead from './AboutHead.astro';
import FormattedDate from './FormattedDate.astro';
import { config, t } from '../lib/site';
import { tr, UI } from '../lib/ui';

interface Props {
	slug: string;
	title: string;
	description?: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	category?: string;
	plain?: boolean;
	/** 版式：about 多一个卷首（头像、名字、称号、座右铭、图标链接）（frontmatter 的 layout） */
	layout?: 'article' | 'about';
}
const { slug, title, description, pubDate, updatedDate, heroImage, category, plain = false, layout = 'article' } = Astro.props;
const about = layout === 'about';
// 文章只有一个普通分类：写了且在分类表里的就是它，否则算「其他」。置顶、最新、搜索是特殊分类，不算在内
const SPECIAL = new Set(['pinned', 'latest', 'search', 'other']);
const home = category && !SPECIAL.has(category) && config.categories.some((c) => c.id === category) ? category : 'other';
---

<section class:list={['reader-doc', { about }]} data-slug={slug} data-title={title} data-cat={home}>
	{/* 正文前不放标题和日期：它们写在章节卡片右边（脚本把 .doc-info 挪过去）。要标题就在 markdown 里写 # */}
	<div class="doc-info" hidden>
		<span class="info-title">{title}</span>
		{
			!plain && pubDate && (
				<span class="info-meta">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span class="info-upd">
							<span {...tr(UI.updated)}>{t(UI.updated)}</span> <FormattedDate date={updatedDate} />
						</span>
					)}
				</span>
			)
		}
	</div>
	{about && <AboutHead />}
	{
		heroImage && (
			<figure class="doc-hero">
				<Image src={heroImage} alt="" width={1200} />
			</figure>
		)
	}
	<div class:list={['prose doc-body', { 'about-body': about }]}>
		<slot />
	</div>
</section>
