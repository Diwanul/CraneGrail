const d = ICONS[icon] ?? ICONS.link;
---

{
	meta ? (
		<Image class="link-icon" src={meta} alt="" width={64} />
	) : (
		<svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true">
			<path d={d} />
		</svg>
	)
}
