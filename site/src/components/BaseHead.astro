---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { faviconHref } from '../site.generated';
import { config, t } from '../lib/site';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata | null;
}

const { title, description = t(config.site.description), image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0a0a0c" />
<link rel="icon" href={faviconHref} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={t(config.site.title)} href={new URL('rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />

<Font cssVariable="--font-atkinson" preload />

<title>{title}</title>
{description && <meta name="description" content={description} />}

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{image && <meta property="og:image" content={new URL(image.src, Astro.site)} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
