---
// 分类图标。site.json 里分类的 icon：
//   - 写成 assets/ 下的图片路径 → 用那张图
//   - 写成下面内置图标的名字（如 "book"）→ 用内置图标
//   - 不写 → 按分类 id 找同名内置图标，找不到用 generic
// 内置图标是线稿，颜色跟随 currentColor。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	id: string;
	icon: string | null;
	meta: ImageMetadata | null;
}
const { id, icon, meta } = Astro.props;

const ICONS: Record<string, string> = {
	// 置顶：一枚图钉
	pinned: 'M9 3.5 H15 M10 3.5 V9.5 L6.5 13.5 H17.5 L14 9.5 V3.5 M12 13.5 V20.5',
	// 最新：叠起来的三张纸（旧配置里的 all 也用它）
	latest: 'M7 8.5 L17 6 L19.5 16 L9.5 18.5 Z M4.5 11 L5.8 16.6 M5.8 16.6 L8 20.5 L16 18.6',
	// 其他：三个点
	other: 'M4 12 A1.6 1.6 0 1 0 7.2 12 A1.6 1.6 0 1 0 4 12 Z M10.4 12 A1.6 1.6 0 1 0 13.6 12 A1.6 1.6 0 1 0 10.4 12 Z M16.8 12 A1.6 1.6 0 1 0 20 12 A1.6 1.6 0 1 0 16.8 12 Z',
	// 搜索：放大镜
	search: 'M10.5 4 A6.5 6.5 0 1 1 10.49 4 Z M15.5 15.5 L21 21',
	all: 'M7 8.5 L17 6 L19.5 16 L9.5 18.5 Z M4.5 11 L5.8 16.6 M5.8 16.6 L8 20.5 L16 18.6',
	// 游戏：手柄
	game: 'M7 9 H17 C20 9 21.5 12 21.5 15 C21.5 17.5 19.5 18.5 18 17 L15.5 14.5 H8.5 L6 17 C4.5 18.5 2.5 17.5 2.5 15 C2.5 12 4 9 7 9 Z M7.5 11.5 V14.5 M6 13 H9 M15.5 12.2 h.01 M17.5 13.8 h.01',
	// 随感：一根羽毛笔
	thoughts: 'M20 4 C13 5 8 10 6.5 17.5 L5 20 M20 4 C19 10 15 15 8.5 16 M10 13 L14.5 12.5 M12.5 9.5 L16.5 9',
	// 生活：一片叶子
	life: 'M5 19 C5 10 10 5 19 5 C19 14 14 19 5 19 Z M5 19 L13 11',
	// 书籍：打开的书
	books: 'M12 7 C9.5 5.5 6.5 5.2 3.5 5.8 V18 C6.5 17.4 9.5 17.7 12 19.2 C14.5 17.7 17.5 17.4 20.5 18 V5.8 C17.5 5.2 14.5 5.5 12 7 Z M12 7 V19.2',
	// 电影：胶片
	film: 'M5 4 H19 V20 H5 Z M8.5 4 V20 M15.5 4 V20 M5 8 H8.5 M5 12 H8.5 M5 16 H8.5 M15.5 8 H19 M15.5 12 H19 M15.5 16 H19',
	// 音乐：音符
	music: 'M9 17.5 V6 L19 4 V15.5 M9 17.5 A2.5 2 0 1 1 4 17.5 A2.5 2 0 1 1 9 17.5 Z M19 15.5 A2.5 2 0 1 1 14 15.5 A2.5 2 0 1 1 19 15.5 Z',
	// 代码：尖括号
	code: 'M8.5 7 L3.5 12 L8.5 17 M15.5 7 L20.5 12 L15.5 17 M13.5 5 L10.5 19',
	// 旅行：指南针
	travel: 'M12 3.5 A8.5 8.5 0 1 1 11.99 3.5 Z M15.5 8.5 L13.2 13.2 L8.5 15.5 L10.8 10.8 Z',
	// 通用：一颗四角星
	generic: 'M12 3 C12.8 9 15 11.2 21 12 C15 12.8 12.8 15 12 21 C11.2 15 9 12.8 3 12 C9 11.2 11.2 9 12 3 Z',
};
const d = ICONS[icon ?? ''] ?? ICONS[id] ?? ICONS.generic;
---

{
	meta ? (
		<Image class="cat-icon" src={meta} alt="" width={96} />
	) : (
		<svg class="cat-icon" viewBox="0 0 24 24" aria-hidden="true">
			<path d={d} />
		</svg>
	)
}
