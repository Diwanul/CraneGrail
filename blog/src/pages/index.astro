---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Slideshow backgrounds. Each background is paired with a line/cite shown at
// the bottom of the splash screen; swap these for your own images & quotes.
import bg1 from '../assets/blog-placeholder-1.jpg';
import bg2 from '../assets/blog-placeholder-2.jpg';
import bg3 from '../assets/blog-placeholder-3.jpg';
import bg4 from '../assets/blog-placeholder-4.jpg';
import bg5 from '../assets/blog-placeholder-5.jpg';

const MOTTO = 'Stay curious, keep building.';

const slides = [
	{ img: bg1, quote: '“The mountains are calling and I must go.” — John Muir' },
	{ img: bg2, quote: '“We are all in the gutter, but some of us are looking at the stars.” — Oscar Wilde' },
	{ img: bg3, quote: '“Not all those who wander are lost.” — J.R.R. Tolkien' },
	{ img: bg4, quote: '“In the middle of difficulty lies opportunity.” — Albert Einstein' },
	{ img: bg5, quote: '“What we know is a drop, what we don’t know is an ocean.” — Isaac Newton' },
];

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const pinned = posts.filter((p) => p.data.pinned).slice(0, 3);
const pinnedIds = new Set(pinned.map((p) => p.id));
const rest = posts.filter((p) => !pinnedIds.has(p.id));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			html.splash-lock {
				overflow: hidden;
			}

			/* ===================== SPLASH / INTRO ===================== */
			.splash {
				position: fixed;
				inset: 0;
				z-index: 1000;
				overflow: hidden;
				color: #fff;
				will-change: transform;
				transition: transform 0.9s cubic-bezier(0.76, 0, 0.24, 1);
			}
			.splash.up {
				transform: translateY(-100%);
			}
			.slides {
				position: absolute;
				inset: 0;
			}
			.slide {
				position: absolute;
				inset: 0;
				background-size: cover;
				background-position: center;
				opacity: 0;
				transform: scale(1.06);
				transition:
					opacity 1.4s ease,
					transform 8s ease;
			}
			.slide.active {
				opacity: 1;
				transform: scale(1);
			}
			.scrim {
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse at center, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.35)),
					linear-gradient(to bottom, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.6));
			}
			.splash-center {
				position: absolute;
				top: 42%;
				left: 50%;
				transform: translate(-50%, -50%);
				text-align: center;
				width: min(90vw, 640px);
			}
			.avatar {
				width: 140px;
				height: 140px;
				border-radius: 50%;
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
				animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) both;
			}
			.motto {
				margin: 1rem 0 0;
				font-size: 1rem;
				font-weight: 400;
				letter-spacing: 0.03em;
				opacity: 0.92;
				text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
				animation: rise 1s 0.15s cubic-bezier(0.22, 1, 0.36, 1) both;
			}
			.splash-bottom {
				position: absolute;
				left: 50%;
				bottom: 4vh;
				transform: translateX(-50%);
				width: min(92vw, 820px);
				text-align: center;
				cursor: pointer;
				user-select: none;
			}
			.quote {
				margin: 0 auto 0.6rem;
				font-size: 1.05rem;
				line-height: 1.5;
				text-shadow: 0 1px 14px rgba(0, 0, 0, 0.7);
				transition: opacity 0.35s ease;
			}
			.chevron {
				font-size: 1.4rem;
				line-height: 1;
				opacity: 0.9;
				animation: bob 1.6s ease-in-out infinite;
			}
			@keyframes bob {
				0%,
				100% {
					transform: translateY(0);
				}
				50% {
					transform: translateY(8px);
				}
			}
			@keyframes rise {
				from {
					opacity: 0;
					transform: translateY(18px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			/* ===================== REAL HOME ===================== */
			.home main {
				width: 1040px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3rem 1rem 4rem;
			}

			/* Pinned / featured row */
			.pinned {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
				margin-bottom: 4rem;
			}
			.pin-card {
				text-decoration: none;
				color: inherit;
				display: block;
			}
			.pin-media {
				position: relative;
				aspect-ratio: 3 / 2;
				border-radius: 14px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
			}
			.pin-media :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.5s ease;
			}
			.pin-card:hover .pin-media :global(img) {
				transform: scale(1.05);
			}
			.pin-overlay {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1.2rem;
				background: rgba(0, 0, 0, 0.62);
				color: #fff;
				opacity: 0;
				transition: opacity 0.45s ease;
			}
			.pin-card:hover .pin-overlay {
				opacity: 1;
			}
			.pin-overlay p {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.6;
				text-align: center;
			}
			.pin-caption {
				margin: 0.8rem 0 0;
				font-size: 1.15rem;
				line-height: 1.3;
				text-align: center;
			}

			/* Post list — alternating image side */
			.post-list {
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}
			.row {
				display: flex;
				align-items: center;
				gap: 2rem;
				text-decoration: none;
				color: inherit;
			}
			.row:nth-child(even) {
				flex-direction: row-reverse;
			}
			.row-media {
				flex: 1 1 50%;
				border-radius: 14px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
			}
			.row-media :global(img) {
				width: 100%;
				aspect-ratio: 16 / 10;
				object-fit: cover;
				display: block;
				transition: transform 0.5s ease;
			}
			.row:hover .row-media :global(img) {
				transform: scale(1.04);
			}
			.row-body {
				flex: 1 1 50%;
			}
			.row-body h3 {
				margin: 0 0 0.6rem;
				font-size: 1.6rem;
				line-height: 1.2;
			}
			.row-body p {
				margin: 0;
				color: rgb(var(--gray-dark));
				line-height: 1.7;
			}

			@media (max-width: 720px) {
				.pinned {
					grid-template-columns: 1fr;
				}
				.row,
				.row:nth-child(even) {
					flex-direction: column;
					gap: 1rem;
				}
				.row-body h3 {
					font-size: 1.35rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.slide,
				.avatar,
				.motto,
				.chevron {
					animation: none;
					transition: opacity 0.4s ease;
				}
			}
		</style>
	</head>
	<body>
		<!-- ===================== SPLASH ===================== -->
		<section class="splash" id="splash" aria-label="Welcome">
			<div class="slides" id="slides">
				{
					slides.map((s, i) => (
						<div
							class:list={['slide', { active: i === 0 }]}
							data-index={i}
							style={`background-image:url(${s.img.src})`}
						/>
					))
				}
			</div>
			<div class="scrim"></div>
			<div class="splash-center">
				<img class="avatar" src="/avatar.svg" alt="avatar" width="140" height="140" />
				<p class="motto">{MOTTO}</p>
			</div>
			<div class="splash-bottom" id="splash-bottom" role="button" tabindex="0" aria-label="Enter site">
				<p class="quote" id="quote" set:html={slides[0].quote}></p>
				<div class="chevron" aria-hidden="true">▽</div>
			</div>
		</section>

		<!-- ===================== REAL HOME ===================== -->
		<div class="home" id="home">
			<Header />
			<main>
				{
					pinned.length > 0 && (
						<section class="pinned">
							{pinned.map((post) => (
								<a class="pin-card" href={`/blog/${post.id}/`}>
									<div class="pin-media">
										{post.data.heroImage && (
											<Image src={post.data.heroImage} alt={post.data.title} width={640} height={426} />
										)}
										<div class="pin-overlay">
											<p>{post.data.description}</p>
										</div>
									</div>
									<h3 class="pin-caption">{post.data.title}</h3>
								</a>
							))}
						</section>
					)
				}

				<section class="post-list">
					{
						rest.map((post) => (
							<a class="row" href={`/blog/${post.id}/`}>
								<div class="row-media">
									{post.data.heroImage && (
										<Image src={post.data.heroImage} alt={post.data.title} width={720} height={450} />
									)}
								</div>
								<div class="row-body">
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</div>
							</a>
						))
					}
				</section>
			</main>
			<Footer />
		</div>

		<script is:inline define:vars={{ quotes: slides.map((s) => s.quote) }}>
			window.__SPLASH_QUOTES = quotes;
		</script>

		<script>
			function initSplash() {
				const QUOTES: string[] = (window as any).__SPLASH_QUOTES ?? [];
				const splash = document.getElementById('splash');
				const slides = Array.from(document.querySelectorAll<HTMLElement>('#slides .slide'));
				const quoteEl = document.getElementById('quote');
				const bottom = document.getElementById('splash-bottom');
				if (!splash || slides.length === 0) return;

				const quotes = slides.map((_, i) => QUOTES[i] ?? quoteEl?.innerHTML ?? '');

				let current = 0;
				let open = true; // splash visible & scroll locked
				let animating = false;
				let timer = 0;

				function show(next: number) {
					if (next === current) return;
					slides[current].classList.remove('active');
					slides[next].classList.add('active');
					current = next;
					if (quoteEl && quotes[next]) {
						quoteEl.style.opacity = '0';
						window.setTimeout(() => {
							quoteEl.innerHTML = quotes[next];
							quoteEl.style.opacity = '1';
						}, 350);
					}
				}
				function startShow() {
					if (timer) return;
					timer = window.setInterval(() => {
						if (!open || slides.length < 2) return;
						let next = current;
						while (next === current) next = Math.floor(Math.random() * slides.length);
						show(next);
					}, 6000);
				}
				function stopShow() {
					if (timer) {
						window.clearInterval(timer);
						timer = 0;
					}
				}

				function close() {
					if (!open || animating) return;
					open = false;
					animating = true;
					splash!.classList.add('up');
					document.documentElement.classList.remove('splash-lock');
					stopShow();
					window.setTimeout(() => {
						splash!.style.pointerEvents = 'none';
						animating = false;
					}, 900);
				}
				function reopen() {
					if (open || animating) return;
					open = true;
					animating = true;
					splash!.style.pointerEvents = 'auto';
					splash!.classList.remove('up');
					document.documentElement.classList.add('splash-lock');
					window.scrollTo(0, 0);
					startShow();
					window.setTimeout(() => {
						animating = false;
					}, 900);
				}

				function onWheel(e: WheelEvent) {
					if (animating) {
						e.preventDefault();
						return;
					}
					if (open) {
						if (e.deltaY > 0) {
							e.preventDefault();
							close();
						}
					} else if (e.deltaY < 0 && window.scrollY <= 0) {
						// back at the very top and scrolling up → bring the intro back
						e.preventDefault();
						reopen();
					}
				}
				let touchY = 0;
				function onTouchStart(e: TouchEvent) {
					touchY = e.touches[0].clientY;
				}
				function onTouchMove(e: TouchEvent) {
					if (animating) return;
					const dy = touchY - e.touches[0].clientY; // >0 = swipe up
					if (open && dy > 30) close();
					else if (!open && dy < -30 && window.scrollY <= 0) reopen();
				}
				function onKey(e: KeyboardEvent) {
					if (open && (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ')) close();
					else if (!open && e.key === 'ArrowUp' && window.scrollY <= 0) reopen();
				}

				function cleanup() {
					window.removeEventListener('wheel', onWheel);
					window.removeEventListener('touchstart', onTouchStart);
					window.removeEventListener('touchmove', onTouchMove);
					window.removeEventListener('keydown', onKey);
					stopShow();
				}
				if ((window as any).__splashCleanup) (window as any).__splashCleanup();
				(window as any).__splashCleanup = cleanup;

				document.documentElement.classList.add('splash-lock');
				startShow();
				window.addEventListener('wheel', onWheel, { passive: false });
				window.addEventListener('touchstart', onTouchStart, { passive: true });
				window.addEventListener('touchmove', onTouchMove, { passive: true });
				window.addEventListener('keydown', onKey);
				bottom?.addEventListener('click', close);
			}

			document.addEventListener('astro:page-load', initSplash);
		</script>
	</body>
</html>
